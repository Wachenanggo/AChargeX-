# Where the OCPP service API lives. Empty = same origin (Vite dev proxy forwards /api to :8080).
# In production on Vercel set it to your OCPP host, e.g. https://ocpp.example.duckdns.org
VITE_API_URL=

# Supabase (public anon key only — NEVER put the service-role key here).
# Leave empty to run in clearly-labelled DEMO mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Show "Continue with Google" only after you enable the Google provider in Supabase Auth.
VITE_GOOGLE_OAUTH=false
