# ---------------------------------------------------------------
# AChargeX OCPP service configuration (server-side ONLY)
# ---------------------------------------------------------------
PORT=8080

# Public URLs (what chargers and the app see)
PUBLIC_OCPP_URL=wss://ocpp.example.duckdns.org/ocpp
PUBLIC_APP_URL=https://achargex.vercel.app

# CORS: your web origin(s), plus the Capacitor origins for the native apps
CORS_ORIGIN=https://achargex.vercel.app,capacitor://localhost,https://localhost

# Supabase — leave empty for DEMO mode. The service-role key must NEVER go to the web app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: legacy HS256 JWT secret (newer projects are verified via JWKS automatically)
SUPABASE_JWT_SECRET=

# Mode switches (defaults: DEMO when Supabase is not configured)
# DEMO_MODE=false
# SIMULATOR=false            # simulated SIM-* chargers (never controls hardware)
# SIM_SPEED=20               # demo time-acceleration of simulated energy delivery
# ALLOW_UNREGISTERED_CHARGERS=false   # let unknown chargers connect so owners can claim them
# ALLOW_DEMO_PAYMENT_ON_REAL=false    # ONLY for an owner testing their own charger for free
# HEARTBEAT_INTERVAL=60
